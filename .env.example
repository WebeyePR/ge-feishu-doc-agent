# --- 飞书 (Lark) 集成配置 ---
# （必填参数）注册 Agent Engine 到 Gemini Enterprise 时设置的 auth_id (唯一资源标识符，自定义)
LARK_AUTH_ID="your-unique-auth-id"  # 如 lark-agent-oauth-id
# （必填参数）飞书开放平台应用 App ID
LARK_CLIENT_ID="your-lark-app-id"
# （必填参数）飞书开放平台应用 App Secret
LARK_CLIENT_SECRET="your-lark-app-secret"

# 飞书开放平台域名
LARK_DOMAIN="https://open.feishu.cn"
# 飞书授权URI
LARK_AUTHORIZATION_URI="https://accounts.feishu.cn/open-apis/authen/v1/authorize?client_id=cli_a9b3af98cdf9dcef&response_type=code&scope=aily%3Afile%3Aread%20aily%3Afile%3Awrite%20application%3Aapplication.app_message_stats.overview%3Areadonly%20application%3Aapplication%3Aself_manage%20application%3Abot.menu%3Awrite%20approval%3Ainstance%3Aread%20approval%3Ainstance%3Awrite%20approval%3Atask%3Aread%20approval%3Atask%3Awrite%20attendance%3Atask%3Areadonly%20base%3Aapp%3Acopy%20base%3Aapp%3Acreate%20base%3Aapp%3Aread%20base%3Aapp%3Aupdate%20base%3Adashboard%3Acreate%20base%3Adashboard%3Adelete%20base%3Adashboard%3Aread%20base%3Adashboard%3Aupdate%20base%3Afield%3Acreate%20base%3Afield%3Adelete%20base%3Afield%3Aread%20base%3Afield%3Aupdate%20base%3Aform%3Acreate%20base%3Aform%3Adelete%20base%3Aform%3Aread%20base%3Aform%3Aupdate%20base%3Ahistory%3Aread%20base%3Arecord%3Acreate%20base%3Arecord%3Adelete%20base%3Arecord%3Aread%20base%3Arecord%3Aupdate%20base%3Arole%3Acreate%20base%3Arole%3Adelete%20base%3Arole%3Aread%20base%3Arole%3Aupdate%20base%3Atable%3Acreate%20base%3Atable%3Adelete%20base%3Atable%3Aread%20base%3Atable%3Aupdate%20base%3Aview%3Aread%20base%3Aview%3Awrite_only%20base%3Aworkflow%3Acreate%20base%3Aworkflow%3Adelete%20base%3Aworkflow%3Aread%20base%3Aworkflow%3Aupdate%20base%3Aworkspace%3Alist%20bitable%3Aapp%20board%3Awhiteboard%3Anode%3Acreate%20board%3Awhiteboard%3Anode%3Adelete%20board%3Awhiteboard%3Anode%3Aread%20calendar%3Acalendar.event%3Acreate%20calendar%3Acalendar.event%3Adelete%20calendar%3Acalendar.event%3Aread%20calendar%3Acalendar.event%3Areply%20calendar%3Acalendar.event%3Aupdate%20calendar%3Acalendar.free_busy%3Aread%20calendar%3Acalendar%3Acreate%20calendar%3Acalendar%3Adelete%20calendar%3Acalendar%3Aread%20calendar%3Acalendar%3Aupdate%20cardkit%3Acard%3Awrite%20contact%3Acontact.base%3Areadonly%20contact%3Auser.base%3Areadonly%20contact%3Auser.basic_profile%3Areadonly%20contact%3Auser.employee_id%3Areadonly%20contact%3Auser%3Asearch%20core